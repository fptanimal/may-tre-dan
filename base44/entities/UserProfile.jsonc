{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email ng\u01b0\u1eddi d\u00f9ng (kh\u1edbp v\u1edbi auth)"
    },
    "full_name": {
      "type": "string",
      "description": "H\u1ecd v\u00e0 t\u00ean"
    },
    "phone": {
      "type": "string",
      "description": "S\u1ed1 \u0111i\u1ec7n tho\u1ea1i"
    },
    "address": {
      "type": "string",
      "description": "\u0110\u1ecba ch\u1ec9 m\u1eb7c \u0111\u1ecbnh"
    },
    "total_orders": {
      "type": "number",
      "default": 0,
      "description": "T\u1ed5ng s\u1ed1 \u0111\u01a1n h\u00e0ng \u0111\u00e3 \u0111\u1eb7t"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "T\u1ed5ng ti\u1ec1n \u0111\u00e3 chi"
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "diamond"
      ],
      "default": "bronze",
      "description": "H\u1ea1ng th\u00e0nh vi\u00ean"
    },
    "vouchers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Danh s\u00e1ch voucher c\u00f3 s\u1eb5n"
    },
    "avatar_url": {
      "type": "string",
      "description": "\u1ea2nh \u0111\u1ea1i di\u1ec7n"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}